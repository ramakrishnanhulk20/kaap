# Copy this file to .env and fill in the values. Never commit .env.

# NEAR AI Cloud API key, from https://cloud.near.ai (create a key in your workspace).
# Set a spend limit on the key itself in the dashboard before using it.
NEAR_AI_API_KEY=

# Optional settings for scripts/WO-02a-deploy-testnet.sh (testnet only).
# KAAP_ACCEPTED_KEY: the ed25519 key the guard and registry obey ("ed25519:<base58>"). Leave empty
# to use the sandbox tests' throwaway key until the sealed program's key replaces it.
KAAP_ACCEPTED_KEY=
# KAAP_GUARD_OWNER: the testnet account that alone may change the guard's key. Leave empty to
# create a fresh faucet account.
KAAP_GUARD_OWNER=
# KAAP_DEPLOY: guard, registry or both (the default).
KAAP_DEPLOY=

# Optional settings for scripts/WO-02c-setup-testnet.mjs and scripts/prove-m1.mjs (testnet only).
# KAAP_TESTNET_RPC: the testnet RPC both scripts send and read through. Default https://rpc.testnet.fastnear.com.
KAAP_TESTNET_RPC=
# KAAP_TESTNET_ARCHIVAL_RPC: an archival testnet RPC, for reading the sealed job's attested run back. Default https://archival-rpc.testnet.fastnear.com.
KAAP_TESTNET_ARCHIVAL_RPC=
# KAAP_MAINNET_RPC: the mainnet RPC the setup reads KAAP_TEMPLATE_DAO from, only when deployments/near-business-policy.json is missing. Default https://rpc.mainnet.fastnear.com.
KAAP_MAINNET_RPC=
# KAAP_TEMPLATE_DAO: a mainnet NEAR Business treasury whose role setup becomes the template, members removed, when that file is missing. No default.
KAAP_TEMPLATE_DAO=
# KAAP_TESTNET_FAUCET: the faucet that funds new demo accounts. Default https://helper.nearprotocol.com/account, the one near-cli uses.
KAAP_TESTNET_FAUCET=

# Kaap's worker, packages/worker (WO-06a). scripts/WO-06-run-local.sh fills every required one
# with the testnet value from deployments/testnet.json when it is left empty here.
# KAAP_NETWORK: testnet or mainnet.
KAAP_NETWORK=
# KAAP_WORKER_ACCOUNT: the account that pays for and sends every sealed run, record and veto.
KAAP_WORKER_ACCOUNT=
# KAAP_WORKER_CREDENTIALS_FILE: path to that account's near-cli key file. The key stays in that file (chmod 600); never paste it here.
KAAP_WORKER_CREDENTIALS_FILE=
# KAAP_GUARD: the kaap-guard contract account.
KAAP_GUARD=
# KAAP_REGISTRY: the kaap-registry contract account.
KAAP_REGISTRY=
# KAAP_OUTLAYER: OutLayer's contract (outlayer.testnet on testnet).
KAAP_OUTLAYER=
# KAAP_SEALED_PROJECT: the sealed program's OutLayer project, <owner account>/<name>.
KAAP_SEALED_PROJECT=
# KAAP_RPC_PRIMARY: the first RPC provider, an https URL; it also sends the worker's transactions.
KAAP_RPC_PRIMARY=
# KAAP_RPC_SECONDARY: the second, independent RPC provider on a different host (C22).
KAAP_RPC_SECONDARY=
# KAAP_WORKER_DB: path of the worker's SQLite file, on a disk that survives restarts.
KAAP_WORKER_DB=
# KAAP_CAP_RUNS_PER_DAO_DAY: most sealed runs per DAO per UTC day (C29).
KAAP_CAP_RUNS_PER_DAO_DAY=
# KAAP_CAP_RECORDS_PER_DAO_DAY: most registry writes per DAO per UTC day (C29).
KAAP_CAP_RECORDS_PER_DAO_DAY=
# KAAP_CAP_NEAR_PER_DAY: most NEAR the worker may commit per UTC day, all DAOs together, such as 1 (C29).
KAAP_CAP_NEAR_PER_DAY=
# Optional tuning, defaults in brackets: KAAP_POLL_MS [1000] counter poll, KAAP_WATCH_MS [15000] re-judge watch,
# KAAP_ENROLLED_MS [60000] enrolled list, KAAP_VERDICT_TTL_MS [600000] verdict life, KAAP_RUN_WINDOW_BLOCKS [220]
# wait for a sealed answer, KAAP_HOLD_ALERT_MS [30000] provider disagreement before an alert, KAAP_BACKFILL_WINDOW [100],
# KAAP_MAX_CONCURRENT_RUNS [4], KAAP_LOG_LEVEL [info], KAAP_ENV_FILE [.env].

# Telegram bot token from BotFather, for member alerts (WO-06b). Ram pastes the real value into .env only.
TELEGRAM_BOT_TOKEN=

# Member alerts and the status page, packages/worker (WO-06b). All optional; defaults in brackets.
# KAAP_SITE_URL: Kaap's own https site, the only place an alert links to. Leave empty for alerts with no link.
KAAP_SITE_URL=
# KAAP_HTTP_HOST [127.0.0.1] and KAAP_HTTP_PORT [8787]: where GET /status and POST /subscribe listen; put an HTTPS proxy in front to make /status public.
KAAP_HTTP_HOST=
KAAP_HTTP_PORT=
# KAAP_ALERT_BATCH_MS [60000]: how long non-critical alerts wait to be sent together; a critical verdict never waits.
KAAP_ALERT_BATCH_MS=
# KAAP_ALERT_CAP_PER_HOUR [30]: most batched messages one chat gets an hour; urgent ones are never capped.
KAAP_ALERT_CAP_PER_HOUR=
# KAAP_LAG_ALERT_MS [15000]: how long an RPC provider may go without answering before "guard degraded".
KAAP_LAG_ALERT_MS=

# The sealed judge's NEAR AI key, packages/worker (WO-05a). The key itself lives only in OutLayer's secret row, never here.
# KAAP_AI_SECRETS_ACCOUNT: the NEAR account that owns that row. No default; left empty, runs carry no key and verdicts have no AI.
KAAP_AI_SECRETS_ACCOUNT=
# KAAP_AI_SECRETS_PROFILE [near-ai]: the row's profile name.
KAAP_AI_SECRETS_PROFILE=

# Member texts, packages/worker (WO-06d): GET /text-key and POST /texts listen beside /status.
# KAAP_TEXTS_PER_ADDRESS_HOUR [3]: most texts one client address may send an hour, 1 to 100; each one costs the worker a sealed run.
KAAP_TEXTS_PER_ADDRESS_HOUR=

# KAAP_WORKER_URL: the worker's https address that `kaap seal-text` posts a sealed text to (packages/cli, WO-07b5). No default.
KAAP_WORKER_URL=

# KAAP_TEST_PAYMENT_KEY: an OutLayer payment key (owner:nonce:secret) for scripts/WO-05e-paid-call.mjs on testnet. Never commit the value.
KAAP_TEST_PAYMENT_KEY=
