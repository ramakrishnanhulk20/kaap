# Copy this file to .env and fill in the values. Never commit .env.

# NEAR AI Cloud API key, from https://cloud.near.ai (create a key in your workspace).
# Set a spend limit on the key itself in the dashboard before using it.
NEAR_AI_API_KEY=

# Optional settings for scripts/WO-02a-deploy-testnet.sh (testnet only).
# KAAP_ACCEPTED_KEY: the ed25519 key the guard and registry obey ("ed25519:<base58>"). Leave empty
# to use the sandbox tests' throwaway key until the sealed program's key replaces it.
KAAP_ACCEPTED_KEY=
# KAAP_GUARD_OWNER: the testnet account that alone may change the guard's key. Leave empty to
# create a fresh faucet account.
KAAP_GUARD_OWNER=
# KAAP_DEPLOY: guard, registry or both (the default).
KAAP_DEPLOY=
